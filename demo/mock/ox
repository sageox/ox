#!/usr/bin/env bash
# Mock ox CLI for demo recording.
# Reproduces current ox CLI output for the cloud-touching commands that can't be
# run deterministically offline (login, init, doctor, status, agent prime).
# Faithful to the real flow: session capture is automatic via `ox agent prime`,
# there is no manual /ox-session-start ritual.
#
# Usage: Add demo/mock/ to PATH before running a tape:
#   export PATH="$(pwd)/demo/mock:$PATH"

# Colors (ox CLI dark theme - true color)
G='\033[38;2;122;143;120m'      # sage green (success/primary)
GB='\033[1;38;2;122;143;120m'   # sage green bold (section headers)
C='\033[38;2;224;165;106m'      # copper gold (secondary/commands)
CB='\033[1;38;2;224;165;106m'   # copper gold bold
DM='\033[38;2;143;153;163m'     # dim gray
B='\033[1m'                      # bold
R='\033[0m'                      # reset

mock_login() {
    echo "Initiating device authentication flow..."
    echo ""
    echo "Visit: https://sageox.ai/device"
    echo "Enter code: ZYNZVRRA"
    echo ""
    sleep 3
    printf "${G}✓ Successfully authenticated${R}\n"
    echo ""
    printf "${G}Welcome back, ${GB}Oxy${G}!${R}\n"
    echo "You're signed in as ox@sageox.ai"
    echo ""
    printf "${G}✓${R} Git credentials synced\n"
    echo ""
    printf "${C}✦${R} Next: ${C}ox init${R} — initialize SageOx in this repo\n"
}

mock_init() {
    printf "${DM}Using endpoint: https://sageox.ai${R}\n"
    echo ""
    printf "${GB}REPOSITORY SETUP${R}\n"
    sleep 0.2
    printf "${G}✓${R} Created .sageox/ directory\n"
    sleep 0.1
    printf "${G}✓${R} Created .sageox/.repo_019c2a28-3596-7ea9-a51e-86fc6c9a3e1f marker\n"
    sleep 0.1
    printf "${G}✓${R} Created .sageox/config.json\n"
    sleep 0.1
    printf "${G}✓${R} Created .sageox/README.md\n"
    sleep 0.1
    printf "${G}✓${R} Created .sageox/.gitignore\n"
    echo ""
    printf "${GB}AGENT INTEGRATION${R}\n"
    sleep 0.2
    printf "${G}✓${R} Injected 'ox agent prime' into AGENTS.md\n"
    sleep 0.1
    printf "${G}✓${R} Installed Claude command(s)\n"
    echo ""
    printf "${GB}GIT & REGISTRATION${R}\n"
    sleep 0.2
    printf "${G}✓${R} Staged files in git\n"
    sleep 0.1
    printf "${G}✓${R} Registered with SageOx (team: team_fl0ur1sh0x)\n"
    sleep 0.1
    printf "${G}✓${R} Git credentials synced\n"
    echo ""
    echo "════════════════════════════════════════════════════════════"
    printf "${B}SageOx initialized successfully!${R}\n"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    printf "${GB}NEXT STEPS${R}\n"
    printf "  1. Commit .sageox/:  ${C}git add .sageox/ && git commit${R}\n"
    printf "  2. Verify setup:     ${C}ox doctor${R}\n"
    echo ""
    printf "${DM}Your AI coworker auto-runs ${R}${C}ox agent prime${R}${DM} at session start.${R}\n"
}

mock_doctor() {
    printf "${B}SageOx Doctor${R}\n"
    printf "${DM}────────────────────${R}\n"
    sleep 0.2
    printf "${G}✓${R} Installation        ox 0.10.0\n"
    sleep 0.1
    printf "${G}✓${R} Authentication      logged in as ${G}Oxy${R} <ox@sageox.ai>\n"
    sleep 0.1
    printf "${G}✓${R} Project config      .sageox/ present and valid\n"
    sleep 0.1
    printf "${G}✓${R} Git remote          ledger reachable\n"
    sleep 0.1
    printf "${G}✓${R} Knowledge Bubbles   3 accessible\n"
    sleep 0.1
    printf "${G}✓${R} Daemon              running, syncing\n"
    sleep 0.1
    printf "${G}✓${R} Redaction policy    active\n"
    echo ""
    printf "${G}All checks passed.${R} ${DM}Run ${R}${C}ox doctor --fix${R}${DM} if any check is ever red.${R}\n"
}

mock_status() {
    printf "${B}Authentication Status${R}\n"
    printf "${DM}────────────────────${R}\n"
    printf "Endpoint          ${G}sageox.ai${R} (${G}✓ logged in${R})\n"
    printf "User              ${G}Oxy${R} <ox@sageox.ai>\n"
    echo ""
    printf "${B}Project Status${R}\n"
    printf "${DM}────────────────────${R}\n"
    echo "Repo directory    /Users/oxy/code/myproject"
    printf "  SageOx state    └── .sageox/ ${G}✓${R}\n"
    echo ""
    printf "${B}Knowledge Bubbles${R}\n"
    printf "${DM}────────────────────${R}\n"
    printf "  ${B}team_fl0ur1sh0x${R}   ${DM}team${R}    ${G}✓ 2h${R}   shared decisions, conventions\n"
    printf "  ${B}myproject${R}         ${DM}repo${R}    ${G}✓ clean${R}   ledger: sessions + murmurs\n"
    printf "  ${B}Oxy${R}               ${DM}you${R}     ${G}✓ 1d${R}   personal notes\n"
    echo ""
    printf "${B}Daemon Sync${R}\n"
    printf "${DM}────────────────────${R}\n"
    printf "Status            ${G}✓ running, syncing${R} (pid 20966)\n"
    printf "Syncing           ${B}2 workspace(s)${R}\n"
    echo ""
    printf "${C}✦${R} Ask your AI coworker about prior sessions — context loads on ${C}ox agent prime${R}\n"
}

mock_agent_prime() {
    printf "${DM}Loading team context…${R}\n"
    sleep 0.6
    printf "${G}✓${R} Primed as ${B}Oxa7b3${R}\n"
    printf "${G}✓${R} Team context loaded  ${DM}(team_fl0ur1sh0x)${R}\n"
    printf "${G}✓${R} Ledger loaded        ${DM}14 prior sessions${R}\n"
    printf "${G}✓${R} Session recording started\n"
}

case "${1:-}" in
    login)  mock_login ;;
    init)   mock_init ;;
    doctor) mock_doctor ;;
    status) mock_status ;;
    agent)
        case "${2:-}" in
            prime) mock_agent_prime ;;
            *)     echo "ox agent: unknown subcommand '${2:-}'"; exit 1 ;;
        esac
        ;;
    *)      echo "ox: unknown command '${1:-}'"; exit 1 ;;
esac
