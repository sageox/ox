# binaries
/bin/
/ox
/ox-adapter-*
!/cmd/ox-adapter-*/
/dist/
/tmp/

# catalog build artifacts (regenerated by `make catalog-build`)
/.context/catalog-out/
/tmp/catalog-vendor/

# binary catalog assets are forbidden (.claude/rules/design.md rule #13).
# These are belt-and-suspenders gitignores; `make check-no-binary-bloat`
# fails the build if any of these ever appear in catalog directories.
docs/design/assets/*.png
docs/design/assets/*.gif
docs/design/assets/*.jpg
docs/design/assets/*.jpeg
docs/design/assets/*.mp4
docs/design/assets/*.webm
docs/design/**/*.png
docs/design/**/*.gif
docs/design/**/*.jpg
docs/design/**/*.jpeg
docs/design/**/*.mp4
docs/design/**/*.webm

# go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# dependencies
/vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# environment
.env
.env.local

# development keys (never commit private keys)
*.pem.dev
**/keys/private.pem

# test coverage
coverage/
coverage.html

# test session artifacts
internal/session/sessions/

# beads profiling/debug files
bd-*
*.prof
.beads/backup

# generated docs - raw markdown only (MDX is manually curated)
docs/reference/*.md
!docs/reference/.gitkeep

# SageOx - this repo is the tool, not a SageOx-enabled project
# Never commit .sageox/ to ox itself
sessions/

# Claude plugin cache/install artifacts (not our source)
.claude-plugin/
# But DO track our plugin marketplace and manifest
!/.claude-plugin/
!/claude-plugin/.claude-plugin/

# Claude Code local settings (user-specific)
.claude/settings.local.json
# Claude worktrees
.claude/worktrees/
# Claude scheduled-task runtime lock (ephemeral: session PID + timestamp)
.claude/scheduled_tasks.lock

.codex/

team-contexts/

demo/credentials.sops.yaml
demo/playwright/node_modules/
.
# Conductor workspace artifacts (blue-green GC reclone)
.gc-diff
.gc-untracked/

# Dolt database files (added by bd init)
.dolt/
*.db

# Never commit age private keys
*-age-key.txt
*.age-key
issues.jsonl

# Beads / Dolt files (added by bd init)
.beads-credential-key
.sageox/kb/
security/.output/
