{
  "SQL": "SELECT substr(c.hash, 1, 10) AS hash,\n       substr(c.message, 1, 80) AS message,\n       d.path, round(ds.score, 2) AS score\nFROM diff_search(?1) ds\nJOIN diffs d ON d.id = ds.diff_id\nJOIN commits c ON c.id = d.commit_id\nWHERE 1=1\n  AND c.timestamp \u003c CAST(strftime('%s', ?2) AS INTEGER)\n  AND c.timestamp \u003e CAST(strftime('%s', ?3) AS INTEGER)\nORDER BY ds.score DESC\nLIMIT 20",
  "Params": [
    "streaming",
    "2026-01-01",
    "2025-06-01"
  ],
  "SearchType": 1
}
