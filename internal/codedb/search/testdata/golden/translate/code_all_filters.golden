{
  "SQL": "SELECT fr.path, cs.score, cs.snippet\nFROM code_search(?1) cs\nJOIN blobs b ON b.id = cs.blob_id\nJOIN file_revs fr ON fr.blob_id = b.id\nJOIN refs r ON r.commit_id = fr.commit_id\nJOIN repos rp ON rp.id = r.repo_id\nWHERE 1=1\n  AND rp.name LIKE ?2\n  AND NOT (rp.name LIKE ?3)\n  AND lower(fr.path) GLOB ?4\n  AND b.language = ?5\n  AND r.name = ?6\nGROUP BY fr.path\nORDER BY cs.score DESC\nLIMIT 10",
  "Params": [
    "foo",
    "%main%",
    "%test%",
    "src/*.go",
    "go",
    "refs/heads/main"
  ],
  "SearchType": 0
}
