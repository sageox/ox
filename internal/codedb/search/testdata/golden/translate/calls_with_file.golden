{
  "SQL": "SELECT DISTINCT fr.path, s.name, s.kind, s.line\nFROM symbol_refs sr\nJOIN symbols s ON s.id = sr.symbol_id\nJOIN blobs b ON b.id = sr.blob_id\nJOIN file_revs fr ON fr.blob_id = b.id\nJOIN refs r ON r.commit_id = fr.commit_id\nWHERE 1=1\n  AND sr.ref_name LIKE ?1\n  AND sr.kind = 'call'\n  AND s.kind = 'function'\n  AND lower(fr.path) GLOB ?2\n  AND r.name IN (?3, ?4)\nORDER BY fr.path, s.line\nLIMIT 20",
  "Params": [
    "%groupby%",
    "*.rs",
    "refs/heads/main",
    "refs/heads/master"
  ],
  "SearchType": 3
}
