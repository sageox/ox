{
  "SQL": "SELECT p.number, p.title, p.author, p.state, p.url\nFROM pull_requests p\nLEFT JOIN pr_comments pc ON pc.pr_id = p.id\nWHERE 1=1\n  AND (p.title LIKE ?1 OR p.body LIKE ?1 OR pc.body LIKE ?1)\n  AND p.updated_at \u003c CAST(strftime('%s', ?2) AS INTEGER)\n  AND p.updated_at \u003e CAST(strftime('%s', ?3) AS INTEGER)\nGROUP BY p.id\nORDER BY p.updated_at DESC\nLIMIT 20",
  "Params": [
    "%fix%",
    "2026-01-01",
    "2025-06-01"
  ],
  "SearchType": 5
}
