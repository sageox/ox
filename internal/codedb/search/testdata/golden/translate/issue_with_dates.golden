{
  "SQL": "SELECT i.number, i.title, i.author, i.state, i.url\nFROM issues i\nLEFT JOIN issue_comments ic ON ic.issue_id = i.id\nWHERE 1=1\n  AND (i.title LIKE ?1 OR i.body LIKE ?1 OR ic.body LIKE ?1)\n  AND i.updated_at \u003c CAST(strftime('%s', ?2) AS INTEGER)\n  AND i.updated_at \u003e CAST(strftime('%s', ?3) AS INTEGER)\nGROUP BY i.id\nORDER BY i.updated_at DESC\nLIMIT 20",
  "Params": [
    "%bug%",
    "2026-01-01",
    "2025-06-01"
  ],
  "SearchType": 6
}
