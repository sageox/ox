{
  "Strategy": 0,
  "BleveQuery": "foo",
  "BleveIndex": "code",
  "SQL": "SELECT fr.path, cs.score, cs.snippet\nFROM code_search(?1) cs\nJOIN blobs b ON b.id = cs.blob_id\nJOIN file_revs fr ON fr.blob_id = b.id\nJOIN refs r ON r.commit_id = fr.commit_id\nWHERE 1=1\n  AND lower(fr.path) GLOB ?2\n  AND r.name IN (?3, ?4)\nGROUP BY fr.path\nORDER BY cs.score DESC\nLIMIT 20",
  "SQLParams": [
    "foo",
    "*.rs",
    "refs/heads/main",
    "refs/heads/master"
  ],
  "SearchType": 0,
  "Limit": 20,
  "IsRegex": false
}
