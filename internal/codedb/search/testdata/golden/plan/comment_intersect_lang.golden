  "BleveIndex": "comment",
  "SQL": "SELECT fr.path, cm.text AS snippet, cm.kind, cm.line, b.language\nFROM comments cm\nJOIN blobs b ON b.id = cm.blob_id\nJOIN file_revs fr ON fr.blob_id = b.id\nJOIN refs r ON r.commit_id = fr.commit_id\nWHERE 1=1\n  AND cm.text LIKE ?1\n  AND b.language = ?2\n  AND r.name IN (?3, ?4)\nORDER BY fr.path, cm.line\nLIMIT 20",
