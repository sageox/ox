{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageox.ai/schemas/attest/v1/manifest.schema.json",
  "title": "SageOx Attest package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_version", "run_document", "files"],
  "properties": {
    "package_version": {"const": "1"},
    "run_document": {"const": "run.json"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:[^./\\\\%?#:\u0000-\u001F\u007F-\u009F]|\\.[^./\\\\%?#:\u0000-\u001F\u007F-\u009F]|\\.\\.[^./\\\\%?#:\u0000-\u001F\u007F-\u009F]|\\.{3,})[^/\\\\%?#:\u0000-\u001F\u007F-\u009F]*(?:/(?:[^./\\\\%?#:\u0000-\u001F\u007F-\u009F]|\\.[^./\\\\%?#:\u0000-\u001F\u007F-\u009F]|\\.\\.[^./\\\\%?#:\u0000-\u001F\u007F-\u009F]|\\.{3,})[^/\\\\%?#:\u0000-\u001F\u007F-\u009F]*)*$"
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "content_type"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_type": {"type": "string", "pattern": "^[^/;\\r\\n]+/[^/;\\r\\n]+$", "maxLength": 255}
      }
    }
  }
}
