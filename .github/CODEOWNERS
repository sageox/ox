# Hosts mount @sageox/plan-review's controls in their own pages, and this
# workflow publishes it.
/packages/plan-review/ @shrimalmadhur
/.github/workflows/plan-review-release.yml @shrimalmadhur

# Agent plugins and settings run with repo access, so every change needs owner review.
# Keep two or more owners: GitHub never lets an author approve their own PR, so a lone
# owner could never land their own change. Any one owner approving the latest commit passes.
/.amp/ @faridun-m @galexy @shrimalmadhur @rsnodgrass @lpavel @vikgup @dedhaw @alex-sageox @realtobyfu @port8080
# Owners also review this file, so the rule above cannot be dropped unseen.
/.github/CODEOWNERS @faridun-m
# A push that both changes .amp/ and deletes or edits this workflow in the
# same commit would silence its own alert before anyone can review it.
/.github/workflows/amp-dir-alert.yml @faridun-m
/.github/workflows/amp-owner-check.yml @faridun-m
